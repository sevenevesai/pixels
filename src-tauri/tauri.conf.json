{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixels Toolkit",
  "version": "1.1.1",
  "identifier": "com.seveneves.pixels-toolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pixels Toolkit",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://seveneves.ai/pixels/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBRDVBNUIzQkI0NUNFMkEKUldRcXprVzdzNlhWYWxyVjBlMGdURnh1WEs3Sm5PemNqTi9zLzVoeFFzaXEvbENsaXVkc0UrdDAK"
    }
  }
}
